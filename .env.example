# Variables de entorno de TaskFlow — plantilla.
# Copiar a `.env` (git-ignorado) y completar los valores locales.
# docker compose lee automáticamente el archivo `.env` para levantar PostgreSQL.

# --- s05: PostgreSQL en Docker ---
# Credenciales del contenedor de Postgres (las usa docker-compose.yml).
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow

# Puerto del host donde se publica Postgres. Si el 5432 ya está ocupado por otra
# base en tu máquina, cambiá este valor (p. ej. 5435) y actualizá DATABASE_URL.
POSTGRES_PORT=5432

# Cadena de conexión que usa la app (s07 en adelante). Incluye el driver de
# SQLAlchemy + psycopg3: postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://taskflow:taskflow@localhost:5432/taskflow
